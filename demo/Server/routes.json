[
    {
        "controller": "\\Controller_Index",
        "action": "index",
        "pattern": "\/",
        "method": "GET",
        "meta": {"public": true}
    },
    {
        "controller": "Controller_Test",
        "action": "index",
        "pattern": "\/test",
        "method": "GET",
        "meta": {"failureLimit": "auth"}
    },
    {
        "controller": "Controller_Test",
        "action": "create",
        "pattern": "\/test",
        "method": "POST",
        "roles": ["editor"],
        "meta": {"failureLimit": "auth", "rateLimit": "write"}
    },
    {
        "controller": "Controller_Test",
        "action": "read",
        "pattern": "\/test\/:testId",
        "method": "GET",
        "meta": {"failureLimit": "auth"}
    },
    {
        "controller": "Controller_Test",
        "action": "update",
        "pattern": "\/test\/:testId",
        "method": "PUT",
        "roles": ["editor"],
        "meta": {"failureLimit": "auth", "rateLimit": "write"}
    },
    {
        "controller": "Controller_Test",
        "action": "delete",
        "pattern": "\/test\/:testId",
        "method": "DELETE",
        "roles": ["editor"],
        "meta": {"failureLimit": "auth", "rateLimit": "write"}
    },
    {
        "controller": "Controller_Test",
        "action": "views",
        "pattern": "\/test\/:testId\/views",
        "method": "GET",
        "meta": {"failureLimit": "auth"}
    }
]
