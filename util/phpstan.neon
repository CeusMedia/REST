includes:
	- ../vendor/phpstan/phpstan-strict-rules/rules.neon
	- phpstan-baseline.neon

parameters:
	phpVersion: 80300
	level: max
	paths:
		- ../src
		- ../test
	excludePaths:
		#  controllers for tests, faulty on purpose
		- ../test/Server/Fixture
#		- ../demo
	ignoreErrors:
		-
			identifier: missingType.iterableValue